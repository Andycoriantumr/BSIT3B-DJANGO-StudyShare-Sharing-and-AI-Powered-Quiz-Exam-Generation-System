# Copy this file to .env and fill in one (or more) provider keys.
# .env is gitignored; never commit real keys.

# Google Gemini (recommended for the StudyShare chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional fallbacks
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=StudyShare
