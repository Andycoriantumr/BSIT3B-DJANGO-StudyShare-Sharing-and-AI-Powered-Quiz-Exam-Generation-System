# Copy this file to .env and fill in one (or more) provider keys.
# .env is gitignored; never commit real keys.

# Django local overrides (optional)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Google Gemini (recommended for the StudyShare chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional fallbacks
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=StudyShare

# MySQL (optional; only used when USE_MYSQL=1)
USE_MYSQL=0
MYSQL_NAME=studyshare
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
