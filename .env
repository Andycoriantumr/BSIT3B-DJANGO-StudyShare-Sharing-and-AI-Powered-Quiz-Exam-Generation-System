# Local environment overrides. This file is gitignored -- never commit real keys.

# Django local overrides (optional)
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Use OpenRouter for both the AI chat and quiz/exam generation.
AI_PROVIDER=openrouter

# OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=StudyShare

# Other providers (optional fallbacks)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MySQL (optional; only used when USE_MYSQL=1)
USE_MYSQL=0
